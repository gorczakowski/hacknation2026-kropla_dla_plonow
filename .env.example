# Optional forwarding proxies, for networks where public APIs throttle a shared IP
# (a hackathon venue). The target URL is appended: <proxy>/https://host/path?query.
# Leave empty to call the services directly.

# Open-Meteo: the Cloudflare Worker in workers/open-meteo-proxy, with its key:
#   https://<worker>.workers.dev/<PROXY_KEY>
OPEN_METEO_PROXY=

# Every other upstream service (GUGiK ULDK and WMS, SoilGrids, BDOT10k, NASA POWER,
# Photon, Copernicus DEM). Planetary Computer always goes direct.
UPSTREAM_PROXY=

# Optional: where fetched source data is cached (default: ./.cache).
DATA_CACHE_DIR=
